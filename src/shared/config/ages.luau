--!strict
-- Human History progression (GAME_SPEC section 5). Each entry is one step; sub-ages such as
-- Paleolithic are milestones inside their age group. Index 0 means "no civilization yet".
export type Cost = { [string]: number }
export type Age = {
	id: string,
	name: string,
	group: string,
	-- Planet population needed before the step can be bought.
	population: number,
	cost: Cost,
	-- Planet-wide production multiplier while this is the current age (not cumulative).
	incomeMultiplier: number,
}
export type Upgrade = {
	id: string,
	name: string,
	-- Age index at which the upgrade becomes available.
	age: number,
	requires: { string },
	cost: Cost,
	-- Production multipliers per resource; "Housing" scales city population.
	effects: { [string]: number },
}
